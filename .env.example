# Database — MUST be an absolute path for Prisma 6 on SQLite.
DATABASE_URL=file:/home/z/my-project/apps/69-screenshot-to-code/db/custom.db

# Optional LLM model override (defaults to gpt-4o)
LLM_MODEL=gpt-4o

# Set to "1" to disable real LLM calls and use the mock provider (tests / offline demo)
PKC_DISABLE_LLM=0
